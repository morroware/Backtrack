{
  "manifest_version": 3,
  "name": "Backtrack Development",
  "version": "0.7.3",
  "description": "Swipe back through page history, then close tabs from right to left.",
  "permissions": [
    "storage",
    "webNavigation"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/shared/gesture-classifier.js",
        "src/shared/gesture-stroke-boundary.js",
        "src/shared/gesture-visual-policy.js",
        "src/shared/navigation-snapshot.js",
        "src/content/navigation-state.js",
        "src/content/gesture-indicator.js",
        "src/content/gesture-debug.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ]
}
